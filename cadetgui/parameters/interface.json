              "dtype": "float", "component_dependent": false,
              "description": "Reference liquid phase concentration, used to normalize the adsorption term.",
              "source": "interface/binding/steric_mass_action.rst SMA_REFC0."
            },
            "reference_solid_phase_conc": {
              "cp_name": "reference_solid_phase_conc", "co_name": "SMA_REFQ",
              "unit": "mol/m^3_SP", "min": 0.0, "min_exclusive": true, "max": null,
              "dtype": "float", "component_dependent": false,
              "description": "Reference solid phase concentration, used to normalize the desorption term.",
              "source": "interface/binding/steric_mass_action.rst SMA_REFQ."
            }
          }
        }
      }
