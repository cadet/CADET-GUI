{
  "$comment": "Parameter metadata ground truth for CADET-GUI. Not GUI-specific: describes CADET-Process<->CADET-Core parameters as they actually are. GUI-layer decisions (which fields to render, how) belong in cadetprocessadapter.py, not here. Sourced from CADET-Core/doc/interface/{binding,unit_operations,solver.rst} and CADET-Process's CADETProcess/processModel/{binding,unitOperation}.py + CADETProcess/simulator/cadetAdapter.py (parameter maps), verified 2026-09-07 -- no invented units/ranges.",
  "categories": {
    "column": {
      "$comment": "Shared TubularReactorBase parameters (length/diameter/axial_dispersion) apply to GeneralRateModel, LumpedRateModelWithPores, LumpedRateModelWithoutPores -- NOT Cstr, which has a different base class and volume-based geometry instead.",
      "shared_parameters": {
        "length": {
          "cp_name": "length",
          "co_name": "BED_LENGTH",
          "co_name_code_variant": "COL_LENGTH",
          "unit": "m",
          "min": 0.0,
          "min_exclusive": true,
          "max": null,
          "dtype": "float",
          "component_dependent": false,
          "description": "Column length.",
          "source": "interface/unit_operations/axial_flow_column_1D_config.rst BED_LENGTH; cadetAdapter.py unit_parameters_map writes COL_LENGTH for the same CADET-Process attribute -- the two doc/code names for the same parameter, not verified which is current upstream, flagged rather than guessed."
        },
        "diameter": {
          "cp_name": "diameter",
          "co_name": null,
          "co_name_note": "Not written directly -- CADETProcess derives CROSS_SECTION_AREA = pi/4 * diameter^2 (see TubularReactorBase.cross_section_area). diameter is a CADET-Process-only convenience attribute.",
          "unit": "m",
          "min": 0.0,
          "min_exclusive": true,
          "max": null,
          "dtype": "float",
          "component_dependent": false,
          "description": "Column diameter (converted to cross-section area before reaching CADET-Core).",
          "source": "CADETProcess/processModel/unitOperation.py TubularReactorBase.cross_section_area; interface/unit_operations/axial_flow_column_1D_config.rst CROSS_SECTION_AREA (unit m^2, range >0)."
        },
        "axial_dispersion": {
          "cp_name": "axial_dispersion",
          "co_name": "COL_DISPERSION",
          "unit": "m^2/s",
          "min": 0.0,
          "min_exclusive": false,
          "max": null,
          "dtype": "float",
          "component_dependent": true,
          "description": "Axial dispersion coefficient.",
          "source": "interface/unit_operations/axial_flow_column_1D_config.rst COL_DISPERSION."
        }
      },
      "models": {
        "GeneralRateModel": {
          "co_unit_type": "GENERAL_RATE_MODEL",
          "extends_shared_parameters": true,
          "required_parameters": [
            "bed_porosity", "particle_porosity", "pore_diffusion",
            "particle_radius", "film_diffusion", "diameter", "length", "axial_dispersion"
          ],
          "own_parameters": {
            "bed_porosity": {
              "cp_name": "bed_porosity", "co_name": "COL_POROSITY",
              "unit": null, "min": 0.0, "min_exclusive": true, "max": 1.0, "max_exclusive": false,
              "dtype": "float", "component_dependent": false,
              "description": "Interstitial (bed) porosity.",
              "source": "interface/unit_operations/axial_flow_column_1D_config.rst COL_POROSITY."
            },
            "particle_porosity": {
              "cp_name": "particle_porosity", "co_name": "PAR_POROSITY",
              "unit": null, "min": 0.0, "min_exclusive": true, "max": 1.0, "max_exclusive": false,
              "dtype": "float", "component_dependent": false,
              "description": "Particle (intraparticle) porosity.",
              "source": "interface/unit_operations/particle_config.rst PAR_POROSITY."
            },
            "particle_radius": {
              "cp_name": "particle_radius", "co_name": "PAR_RADIUS",
              "unit": "m", "min": 0.0, "min_exclusive": true, "max": null,
              "dtype": "float", "component_dependent": false,
              "description": "Particle radius.",
              "source": "interface/unit_operations/particle_config.rst PAR_RADIUS."
            },
            "film_diffusion": {
              "cp_name": "film_diffusion", "co_name": "FILM_DIFFUSION",
              "unit": "m/s", "min": 0.0, "min_exclusive": false, "max": null,
              "dtype": "float", "component_dependent": true,
              "description": "Film diffusion coefficient (mass transfer through the particle film) per component.",
              "source": "interface/unit_operations/particle_config.rst FILM_DIFFUSION."
            },
            "pore_diffusion": {
              "cp_name": "pore_diffusion",
              "co_name": "PORE_DIFFUSION",
              "co_name_code_variant": "PAR_DIFFUSION",
              "unit": "m^2/s", "min": 0.0, "min_exclusive": true, "max": null,
              "dtype": "float", "component_dependent": true,
              "description": "Effective pore diffusion coefficient per component.",
              "source": "interface/unit_operations/particle_config.rst PORE_DIFFUSION; cadetAdapter.py unit_parameters_map writes PAR_DIFFUSION for GeneralRateModel -- same doc/code name mismatch pattern as COL_LENGTH/BED_LENGTH, flagged not resolved."
            },
            "c": {
              "cp_name": "c", "co_name": "INIT_C",
              "unit": "mol/m^3_IV", "min": 0.0, "min_exclusive": false, "max": null,
              "dtype": "float", "component_dependent": true,
              "description": "Initial concentration in the bulk mobile phase, per component.",
              "source": "interface/unit_operations/axial_flow_column_1D_config.rst INIT_C; cadetAdapter.py unit_parameters_map maps INIT_C -> c the same way for every column model, including Cstr."
            },
            "cp": {
              "cp_name": "cp", "co_name": "INIT_CP",
              "unit": "mol/m^3_MP", "min": 0.0, "min_exclusive": false, "max": null,
              "dtype": "float", "component_dependent": true,
              "description": "Initial concentration in the particle liquid (pore) phase, per component. Only meaningful for models with an explicit particle pore phase (GRM, LRMP).",
              "source": "interface/unit_operations/particle_config.rst INIT_CP."
            },
            "q": {
              "cp_name": "q", "co_name": "INIT_Q",
              "co_name_doc_variant": "INIT_CS",
              "unit": "mol/m^3_SP", "min": 0.0, "min_exclusive": false, "max": null,
              "dtype": "float", "component_dependent": true,
              "description": "Initial concentration in the solid (bound) phase, per component. Stays unset (None, hidden) until a real binding model -- not NoBinding -- actually gives the column bound states.",
              "source": "interface/unit_operations/particle_config.rst INIT_CS (the doc name for what cadetAdapter.py's unit_parameters_map calls INIT_Q for every column model -- same doc/code naming mismatch pattern as COL_LENGTH/BED_LENGTH)."
            },
            "pore_accessibility": {
              "cp_name": "pore_accessibility", "co_name": "PORE_ACCESSIBILITY",
              "unit": null, "min": 0.0, "min_exclusive": true, "max": 1.0, "max_exclusive": false,
              "dtype": "float", "component_dependent": true,
              "description": "Fraction of pore volume accessible to each component (defaults to 1, i.e. fully accessible). Only meaningful for models with a particle pore phase (GRM, LRMP); CADET-Core's own docs say not to combine this with a binding model.",
              "source": "interface/unit_operations/particle_config.rst PORE_ACCESSIBILITY."
            },
            "surface_diffusion": {
              "cp_name": "surface_diffusion", "co_name": "PAR_SURFDIFFUSION",
              "co_name_doc_variant": "SURFACE_DIFFUSION",
              "unit": "m^2_SP/s", "min": 0.0, "min_exclusive": false, "max": null,
              "dtype": "float", "component_dependent": true,
              "description": "Particle surface diffusion coefficient per bound state of each component. Only applied when CADET-Core's HAS_SURFACE_DIFFUSION flag is set, which the GUI doesn't currently expose -- this stays unset (None, hidden) here.",
              "source": "interface/unit_operations/particle_config.rst SURFACE_DIFFUSION; cadetAdapter.py unit_parameters_map writes PAR_SURFDIFFUSION for GeneralRateModel -- same doc/code name mismatch pattern as COL_LENGTH/BED_LENGTH."
            },
            "flow_direction": {
              "cp_name": "flow_direction", "co_name": null,
              "co_name_note": "Not written directly -- CADET-Process flips the sign of the VELOCITY it writes based on this Switch rather than passing it through as its own CADET-Core field.",
              "unit": null, "min": -1.0, "min_exclusive": false, "max": 1.0, "max_exclusive": false,
              "dtype": "float", "component_dependent": false,
              "description": "Flow direction: 1 = forward, -1 = backward. CADET-Process's own Switch descriptor only accepts these two exact values; the bounded numeric field this renders as doesn't restrict entries to just them, same as any other min/max-bounded field -- CADET-Process's setter still rejects anything else on assignment.",
              "source": "CADETProcess/processModel/unitOperation.py TubularReactorBase.flow_direction = Switch(valid=[-1, 1], default=1); interface/unit_operations/axial_flow_column_1D_config.rst VELOCITY (the field this sign is ultimately applied to)."
            }
          }
        },
        "LumpedRateModelWithPores": {
          "co_unit_type": "LUMPED_RATE_MODEL_WITH_PORES",
          "extends_shared_parameters": true,
          "required_parameters": [
            "bed_porosity", "particle_porosity", "particle_radius",
            "film_diffusion", "diameter", "length", "axial_dispersion"
          ],
          "own_parameters": {
            "bed_porosity": { "$ref": "categories.column.models.GeneralRateModel.own_parameters.bed_porosity" },
            "particle_porosity": { "$ref": "categories.column.models.GeneralRateModel.own_parameters.particle_porosity" },
            "particle_radius": { "$ref": "categories.column.models.GeneralRateModel.own_parameters.particle_radius" },
            "film_diffusion": { "$ref": "categories.column.models.GeneralRateModel.own_parameters.film_diffusion" },
            "c": { "$ref": "categories.column.models.GeneralRateModel.own_parameters.c" },
            "cp": { "$ref": "categories.column.models.GeneralRateModel.own_parameters.cp" },
            "q": { "$ref": "categories.column.models.GeneralRateModel.own_parameters.q" },
            "pore_accessibility": { "$ref": "categories.column.models.GeneralRateModel.own_parameters.pore_accessibility" },
            "flow_direction": { "$ref": "categories.column.models.GeneralRateModel.own_parameters.flow_direction" }
          }
        },
        "LumpedRateModelWithoutPores": {
          "co_unit_type": "LUMPED_RATE_MODEL_WITHOUT_PORES",
          "extends_shared_parameters": true,
          "required_parameters": ["total_porosity", "diameter", "length", "axial_dispersion"],
          "own_parameters": {
            "total_porosity": {
              "cp_name": "total_porosity", "co_name": "TOTAL_POROSITY",
              "unit": null, "min": 0.0, "min_exclusive": true, "max": 1.0, "max_exclusive": false,
              "dtype": "float", "component_dependent": false,
              "description": "Total porosity (bed + particle combined into one lumped value; there are no explicit particles in this model).",
              "source": "interface/unit_operations/axial_flow_column_1D_config.rst TOTAL_POROSITY."
            },
            "c": { "$ref": "categories.column.models.GeneralRateModel.own_parameters.c" },
            "q": { "$ref": "categories.column.models.GeneralRateModel.own_parameters.q" },
            "flow_direction": { "$ref": "categories.column.models.GeneralRateModel.own_parameters.flow_direction" }
          }
        },
        "Cstr": {
          "co_unit_type": "CSTR",
          "required_parameters": ["init_liquid_volume"],
