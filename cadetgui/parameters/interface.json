            "init_liquid_volume": {
              "cp_name": "init_liquid_volume", "co_name": "INIT_LIQUID_VOLUME",
              "unit": "m^3", "min": 0.0, "min_exclusive": false, "max": null,
              "dtype": "float", "component_dependent": false,
              "description": "Initial liquid volume in the tank.",
              "source": "interface/unit_operations/cstr.rst INIT_LIQUID_VOLUME."
            },
            "c": { "$ref": "categories.column.models.GeneralRateModel.own_parameters.c" },
            "q": { "$ref": "categories.column.models.GeneralRateModel.own_parameters.q" },
            "flow_rate_filter": {
              "cp_name": "flow_rate_filter", "co_name": "FLOWRATE_FILTER",
              "unit": "m^3/s", "min": 0.0, "min_exclusive": false, "max": null,
              "dtype": "float", "component_dependent": false,
              "description": "Flow rate of pure liquid (no components) leaving through the CSTR's filter, on top of its regular outlet flow.",
              "source": "interface/unit_operations/cstr.rst FLOWRATE_FILTER."
            },
            "const_solid_volume": {
              "cp_name": "const_solid_volume", "co_name": "CONST_SOLID_VOLUME",
              "unit": "m^3", "min": 0.0, "min_exclusive": false, "max": null,
              "dtype": "float", "component_dependent": false,
              "description": "Fixed solid-phase volume in the tank, for binding in a CSTR.",
              "source": "interface/unit_operations/cstr.rst CONST_SOLID_VOLUME."
            }
          }
        }
      }
    },
    "binding": {
      "$comment": "No shared_parameters section: unlike column models, the same CADET-Process attribute name (e.g. capacity) means a genuinely different thing per binding model -- for Langmuir it is per-component (length NCOMP), for StericMassAction it is a single scalar (length 1). Sharing a definition across models would silently misrepresent one of them, which is exactly the bug this file exists to avoid (see cadetgui's PARAM_SCHEMA / REQUIREMENTS.md item #12).",
      "models": {
        "NoBinding": {
          "co_model_name": "NONE",
          "required_parameters": [],
          "own_parameters": {}
        },
        "Linear": {
          "co_model_name": "LINEAR",
          "required_parameters": ["adsorption_rate", "desorption_rate"],
          "own_parameters": {
            "adsorption_rate": {
              "cp_name": "adsorption_rate", "co_name": "LIN_KA",
              "unit": "m^3_MP/(m^3_SP*s)", "min": 0.0, "min_exclusive": false, "max": null,
              "dtype": "float", "component_dependent": true,
              "description": "Adsorption rate constant.",
              "source": "interface/binding/linear.rst LIN_KA."
            },
            "desorption_rate": {
              "cp_name": "desorption_rate", "co_name": "LIN_KD",
              "unit": "1/s", "min": 0.0, "min_exclusive": false, "max": null,
              "dtype": "float", "component_dependent": true,
              "description": "Desorption rate constant.",
              "source": "interface/binding/linear.rst LIN_KD."
            },
            "is_kinetic": {
              "cp_name": "is_kinetic", "co_name": "IS_KINETIC",
              "unit": null, "min": null, "min_exclusive": false, "max": null,
              "dtype": "bool", "component_dependent": false,
              "description": "Kinetic (true) vs. quasi-stationary/rapid-equilibrium (false) adsorption. Not in CADET-Process's own required_parameters (it has a non-None default, True), so it never auto-renders -- build_parameter_config_spec adds it explicitly for binding models with a real isotherm.",
              "source": "CADETProcess/processModel/binding.py BindingBaseClass.is_kinetic (Bool, default True); interface/binding/multi_component_langmuir.rst IS_KINETIC."
            }
          }
        },
        "Langmuir": {
          "co_model_name": "MULTI_COMPONENT_LANGMUIR",
          "required_parameters": ["adsorption_rate", "desorption_rate", "capacity"],
          "own_parameters": {
            "adsorption_rate": {
              "cp_name": "adsorption_rate", "co_name": "MCL_KA",
              "unit": "m^3_MP/(mol*s)", "min": 0.0, "min_exclusive": false, "max": null,
              "dtype": "float", "component_dependent": true,
              "description": "Adsorption rate constant. Unit differs from Linear/StericMassAction's adsorption_rate (mol-based here, volume-based there) -- do not share one definition across binding models.",
              "source": "interface/binding/multi_component_langmuir.rst MCL_KA."
            },
            "desorption_rate": {
              "cp_name": "desorption_rate", "co_name": "MCL_KD",
              "unit": "1/s", "min": 0.0, "min_exclusive": false, "max": null,
              "dtype": "float", "component_dependent": true,
              "description": "Desorption rate constant.",
              "source": "interface/binding/multi_component_langmuir.rst MCL_KD."
            },
            "capacity": {
              "cp_name": "capacity", "co_name": "MCL_QMAX",
              "unit": "mol/m^3_SP", "min": 0.0, "min_exclusive": true, "max": null,
              "dtype": "float", "component_dependent": true,
              "description": "Maximum adsorption capacity, per component. Unlike StericMassAction.capacity (a single scalar shared by all components), Langmuir's capacity is genuinely per-component.",
              "source": "interface/binding/multi_component_langmuir.rst MCL_QMAX; CADETProcess/processModel/binding.py Langmuir.capacity = SizedUnsignedList(size=\"n_comp\")."
            },
            "is_kinetic": {
              "cp_name": "is_kinetic", "co_name": "IS_KINETIC",
              "unit": null, "min": null, "min_exclusive": false, "max": null,
              "dtype": "bool", "component_dependent": false,
              "description": "Kinetic (true) vs. quasi-stationary/rapid-equilibrium (false) adsorption. Not in CADET-Process's own required_parameters (it has a non-None default, True), so it never auto-renders -- build_parameter_config_spec adds it explicitly for binding models with a real isotherm.",
              "source": "CADETProcess/processModel/binding.py BindingBaseClass.is_kinetic (Bool, default True); interface/binding/multi_component_langmuir.rst IS_KINETIC."
            }
          }
        },
        "StericMassAction": {
          "co_model_name": "STERIC_MASS_ACTION",
          "required_parameters": [
