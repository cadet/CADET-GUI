              "dtype": "float", "component_dependent": true,
              "description": "Characteristic charge (nu): number of resin sites the protein interacts with.",
              "source": "interface/binding/steric_mass_action.rst SMA_NU."
            },
            "steric_factor": {
              "cp_name": "steric_factor", "co_name": "SMA_SIGMA",
              "unit": null, "min": 0.0, "min_exclusive": false, "max": null,
              "dtype": "float", "component_dependent": true,
              "description": "Steric factor (sigma): number of resin sites shielded by the bound protein.",
              "source": "interface/binding/steric_mass_action.rst SMA_SIGMA."
            },
            "capacity": {
              "cp_name": "capacity", "co_name": "SMA_LAMBDA",
              "unit": "mol/m^3_SP", "min": 0.0, "min_exclusive": false, "max": null,
              "dtype": "float", "component_dependent": false,
              "description": "Stationary phase (ionic) capacity -- a single value shared by the whole resin, not per component. Unlike Langmuir.capacity (per-component), this is a scalar (length 1).",
              "source": "interface/binding/steric_mass_action.rst SMA_LAMBDA (Length: 1); CADETProcess/processModel/binding.py StericMassAction.capacity = UnsignedFloat()."
            },
            "is_kinetic": {
              "cp_name": "is_kinetic", "co_name": "IS_KINETIC",
              "unit": null, "min": null, "min_exclusive": false, "max": null,
              "dtype": "bool", "component_dependent": false,
              "description": "Kinetic (true) vs. quasi-stationary/rapid-equilibrium (false) adsorption. Not in CADET-Process's own required_parameters (it has a non-None default, True), so it never auto-renders -- build_parameter_config_spec adds it explicitly for binding models with a real isotherm.",
              "source": "CADETProcess/processModel/binding.py BindingBaseClass.is_kinetic (Bool, default True); interface/binding/multi_component_langmuir.rst IS_KINETIC."
